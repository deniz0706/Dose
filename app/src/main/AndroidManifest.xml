<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bildirimler -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- İlaç saatini mümkün olduğunca kesin zamanlamak için -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Tablet yeniden başladığında hatırlatıcıları yeniden kurmak için -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Bildirim titreşimi -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".DoseApp"
        android:allowBackup="true"
        android:label="Dose"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dose">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.ReminderActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
